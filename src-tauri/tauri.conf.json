{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "26.3-JM",
  "version": "26.3.1",
  "identifier": "com.joeyjm.mc263",
  "mainBinaryName": "26.3-JM",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare-game.mjs",
    "beforeBuildCommand": "node scripts/prepare-game.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "26.3-JM",
        "url": "index.html",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "theme": "Dark",
        "backgroundColor": "#000000",
        "backgroundThrottling": "disabled",
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false,
        "allowLinkPreview": false,
        "devtools": false,
        "incognito": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Game",
    "publisher": "Joey-JM",
    "copyright": "Minecraft content and assets \u00a9 Mojang. Build by Joey-JM, based on Eaglercraft 26.2 by o_xer.",
    "shortDescription": "26.3-JM \u2014 native macOS build",
    "longDescription": "26.3-JM is a custom browser build based on Eaglercraft 26.2 with selected Minecraft 26.3 features backported, packaged as a native macOS application with ultra-high-performance rendering enabled.",
    "homepage": "https://github.com/joeymavv/26.3-JM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      },
      "infoPlist": "Info.plist"
    }
  }
}
